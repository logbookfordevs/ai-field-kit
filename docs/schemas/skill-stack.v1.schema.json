{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AFK skill stack version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "sources"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "id": { "$ref": "#/$defs/identifier" },
    "name": { "$ref": "#/$defs/text" },
    "description": { "$ref": "#/$defs/text" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source", "skills"],
        "properties": {
          "name": { "$ref": "#/$defs/text" },
          "source": { "allOf": [{ "$ref": "#/$defs/text" }, { "pattern": "^[^-]" }] },
          "skills": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$", "maxLength": 200 },
    "text": { "type": "string", "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f])(?=[\\s\\S]*\\S)[\\s\\S]+$", "maxLength": 4000 }
  }
}
