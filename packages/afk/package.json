{
  "name": "@logbookfordevs/afk",
  "version": "2.2.0",
  "description": "Local workspace for skills, shared profiles, favorite sources, tools, and agent rules.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logbookfordevs/ai-field-kit.git",
    "directory": "packages/afk"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "afk": "dist/index.js"
  },
  "files": [
    "web/**/*",
    "docs/**/*",
    "skills/afk-cli/**/*",
    "dist/**/*.js",
    "!dist/**/*.test.js",
    "!dist/**/*.test-helper.js"
  ],
  "scripts": {
    "clean": "node -e \"for (const path of ['dist', 'skills/afk-cli', 'web']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc && node scripts/bundle-skill.mjs && vite build --config app/vite.config.ts",
    "app:dev": "vite --config app/vite.config.ts",
    "typecheck": "npx tsc --noEmit && npx tsc --noEmit -p app",
    "prepack": "pnpm run build",
    "release:pack": "../../scripts/package-afk-release.sh",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.0"
  }
}
