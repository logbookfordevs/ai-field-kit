{
  "name": "@logbookfordevs/afk",
  "version": "2.0.0",
  "description": "Local workspace for skills, shared profiles, favorite sources, tools, and agent rules.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logbookfordevs/ai-field-kit.git",
    "directory": "packages/afk"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "afk": "dist/index.js"
  },
  "files": [
    "web/**/*",
    "docs/**/*",
    "skills/afk-cli/**/*",
    "dist/**/*.js",
    "!dist/**/*.test.js",
    "!dist/**/*.test-helper.js"
  ],
  "scripts": {
    "clean": "node -e \"for (const path of ['dist', 'skills/afk-cli']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc && node scripts/bundle-skill.mjs",
    "typecheck": "npx tsc --noEmit",
    "prepack": "pnpm run build",
    "release:pack": "../../scripts/package-afk-release.sh",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
